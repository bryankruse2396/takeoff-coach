# Copy this file to .env (same folder) and fill in the values. .env is never committed to GitHub.
# Values: Supabase > Project Settings > API Keys. Use the PUBLISHABLE key, never the secret / service_role key.
# The build machine gets these from the repository's GitHub secrets of the same names.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
